<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="false"
    android:layout_height="match_parent"
    android:background="#2d2d2d">


    <com.google.android.material.appbar.AppBarLayout
        style="@style/ToolbarV3"
        android:backgroundTint="#202020"
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarHome"
            android:backgroundTint="#202020"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="0dp"
            app:elevation="0dp"
            app:layout_scrollFlags="scroll">

            <com.samourai.sentinel.widgets.CircleImageView
                android:src="@drawable/icon_innergradient"
                android:id="@+id/toolbarIcon"
                android:background="?selectableItemBackground"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:layout_marginTop="15dp"/>

        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center|center_vertical"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeBalanceBtc"
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center|center_horizontal"
                android:textSize="24sp"
                tools:text="30.0332 BTC" />

            <TextView
                android:id="@+id/exchangeRateTxt"
                style="@style/TextAppearance.AppCompat.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center|center_horizontal"
                android:textSize="14sp"
                tools:text="1234 USD" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:id="@+id/welcomeMessage"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/spacing_xlarge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#9A9A9A"
            android:text="Sentinel can organize and track many different \npublic keys such as bitcoin addresses or extended \npublic keys
\n\nYour watch list is empty. Add your first public key to begin tracking with Sentinel
" />
    </androidx.core.widget.NestedScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshCollection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="144dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
      Bottom stack: the FAB sits ABOVE the sync banner so the two can never
      overlap. Both were previously anchored to the bottom of the
      CoordinatorLayout independently, which made the "New" button cover the
      banner text and its Retry button.
    -->
    <LinearLayout
        android:id="@+id/bottomStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/fab_margin"
            android:elevation="0dp"
            android:paddingHorizontal="54dp"
            android:text="New"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            app:elevation="12dp"
            app:iconTint="@color/white"
            app:shapeAppearance="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

        <!--
          Sync status banner. Replaces the indefinite SwipeRefreshLayout spinner as
          the primary loading affordance so the user always gets a reason and a way
          out.
        -->
        <LinearLayout
            android:id="@+id/syncStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252525"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/syncStatusProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:indeterminateTint="@color/warning_yellow" />

            <TextView
                android:id="@+id/syncStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#DDDDDD"
                android:textSize="13sp"
                tools:text="Connecting via Tor…" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/syncRetryButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Retry"
                android:textColor="@color/green_ui_2"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>